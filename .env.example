# Copy to .env for local development (npm run dev). On Vercel set these in Project Settings -> Environment Variables.
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public URL of the app (used for the Google OAuth redirect). Optional: derived from the request when unset.
APP_URL=http://localhost:5173
# Turso (injected by the Vercel Marketplace integration). Unset locally -> file:.data/local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
