{
  "name": "meetflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "tsx watch scripts/dev-server.ts",
    "build": "node scripts/migrate.mjs --if-configured && tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "framer-motion": "^11.11.17",
    "hono": "^4.6.12",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@hono/node-server": "1.19.18",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "4.23.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  },
  "engines": {
    "node": ">=20"
  }
}
